{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hisab-kitab-ten-pi.vercel.app",
        "EXPO_PUBLIC_LAUNCH_PHASE": "ALL_FREE",
        "EXPO_PUBLIC_FORCE_PLUS": "1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hisab-kitab-ten-pi.vercel.app",
        "EXPO_PUBLIC_LAUNCH_PHASE": "ALL_FREE",
        "EXPO_PUBLIC_FORCE_PLUS": "1"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
