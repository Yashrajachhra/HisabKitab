# Mobile app (Expo). Personal data never uses these for storage.
# Only group sync talks to the API.
EXPO_PUBLIC_API_URL=http://localhost:4000
# All premium features are free (PDF, unlimited OCR, unlimited groups, tag analytics).
EXPO_PUBLIC_LAUNCH_PHASE=ALL_FREE
# Kept for compatibility; OCR is unlimited while ALL_FREE / Plus unlocked.
EXPO_PUBLIC_OCR_FREE_MONTHLY_LIMIT=20
EXPO_PUBLIC_FORCE_PLUS=1
