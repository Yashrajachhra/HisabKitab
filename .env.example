# Mobile app (Expo). Personal data never uses these for storage.
# Only group sync talks to the API.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Keep ALL_FREE so every feature is unlocked during launch (months 1–4).
# Switch to FREEMIUM later to enforce free-tier OCR/group limits (no app update needed).
EXPO_PUBLIC_LAUNCH_PHASE=ALL_FREE
# Only applied when EXPO_PUBLIC_LAUNCH_PHASE=FREEMIUM.
EXPO_PUBLIC_OCR_FREE_MONTHLY_LIMIT=20
# Optional Plus unlock while FREEMIUM (no real payments yet)
EXPO_PUBLIC_FORCE_PLUS=0
